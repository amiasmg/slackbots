# Copy to .env and fill in values. Never commit .env.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# Defaults to the top-of-funnel-pipeline channel from the old zaps
# TOP_OF_FUNNEL_CHANNEL=C03BS548340

ANTHROPIC_API_KEY=
# FUNNEL_MODEL=claude-sonnet-5-5

AFFINITY_API_KEY=
AFFINITY_LIST_ID=

PITCHBOOK_API_KEY=
SPECTER_API_KEY=

# true = agent reads everything but never creates companies / list entries
# FUNNEL_DRY_RUN=false

# Pipeline column names in your Affinity list (matched case-insensitively)
# AFFINITY_STAGE_FIELD=Stage
# AFFINITY_WATCHLIST_STAGE=Watchlist
# AFFINITY_OWNERS_FIELD=Owners

# Paid lookups (Specter/Pitchbook) are cached per company for this many hours
# FUNNEL_CACHE_TTL_HOURS=72

# Email intake, option 1 (preferred): Microsoft Graph polling of the shared mailbox
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# FUNNEL_MAILBOX=qed.topfunnel@qedinvestors.com
# FUNNEL_MAIL_POLL_SECONDS=60

# Email intake, option 2 (fallback): webhook, e.g. from a Zap. Off unless a port is set.
# FUNNEL_WEBHOOK_PORT=8080
# FUNNEL_WEBHOOK_SECRET=
